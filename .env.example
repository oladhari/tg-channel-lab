# =======================
# App
# =======================
APP_ENV=prod
APP_NAME=tg-channel-lab

# =======================
# Database
# =======================
POSTGRES_DB=tg_lab
POSTGRES_USER=tg_lab
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://tg_lab:change_me@db:5432/tg_lab

# =======================
# Telegram (Telethon)
# =======================
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# CRITICAL: each service MUST use its own session file.
# Sharing the same session causes SQLite lock conflicts and crashes buyer/trader.
# Create each session once with the auth script in README Step 3.
TELEGRAM_SESSION_LISTENER=tg_lab_session_listener
TELEGRAM_SESSION_BUYER=tg_lab_session_buyer
TELEGRAM_SESSION_TRADER=tg_lab_session_trader
TELEGRAM_SESSION_DIR=/app/sessions

# GMGN Telegram bot target (the bot you send /buy and /sell commands to)
GMGN_TARGET=

# =======================
# Price recording
# =======================
# Total recording window per call (seconds). Default = 25 min = 1500s
RECORD_DURATION_SEC=1500

# Adaptive polling: fast mode for the first POLL_FAST_SEC seconds of a new call
POLL_FAST_SEC=120
POLL_FAST_INTERVAL_SEC=2
POLL_SLOW_INTERVAL_SEC=5

# If entry price cannot be fetched within this many seconds, mark call IGNORED_NO_PRICE
NO_PRICE_TIMEOUT_SEC=30

# Circuit breaker: skip HTTP price APIs after this many consecutive failures per mint
CIRCUIT_MAX_FAILS=5
CIRCUIT_BREAK_SEC=30

# =======================
# Strategy thresholds
# =======================
# DISPLAY_TP_PCT / DISPLAY_SL_PCT: used by the recorder's live-monitor thread
# and main loop to detect early TP/SL exits and compute StrategyResults.
# These are the GLOBAL defaults. Per-channel TP/SL can be set from the UI
# and will OVERRIDE these values for that channel.
DISPLAY_TP_PCT=35
DISPLAY_SL_PCT=20

# SIM_TP_PCT / SIM_SL_PCT: used by the simulation/backtesting routes
SIM_TP_PCT=35.0
SIM_SL_PCT=20.0

# Paper trading entry amount (used only in simulation stats)
PAPER_ENTRY_SOL=0.1

# =======================
# GMGN live trading (fallback)
# =======================
# GMGN_TARGET: the Telegram bot to send /buy and /sell commands to
# Leave empty to disable GMGN fallback (buyer and trader workers will be idle)
GMGN_TARGET=
GMGN_SELL_PERCENT=100%

# Cooldown between re-sends to the same call (prevents duplicate commands)
GMGN_BUY_COOLDOWN_SEC=15
GMGN_SELL_COOLDOWN_SEC=45

# =======================
# Live Solana trading (buyer-live + trader-live)
# =======================
# Set SOLANA_PRIVATE_KEY to enable on-chain trading via Jupiter/Raydium/Jito.
# Accepts JSON array format [1,2,3,...] or base58 secret key.
# Leave empty to disable on-chain trading (GMGN fallback will still work).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=

# Default buy amount in SOL per trade (channel can override this from the UI)
LIVE_BUY_AMOUNT_SOL=0.1

# Use high-priority transactions for faster landing
LIVE_FAST_MODE=1

# Confirmation timeout after sending TX (ms). 5000ms = 5 seconds.
LIVE_CONFIRM_MS=5000

# Percentage of token balance to sell (100 = sell everything)
LIVE_SELL_PERCENT=100

# Slippage ladder (bps). Each step is tried in order until one succeeds.
# 2500 = 25%, 5000 = 50%, 10000 = 100%, 20000 = 200%
LIVE_SLIPPAGE_STEPS_BPS=2500,5000,10000,20000

# Max age of a pending buy/sell signal (seconds).
# Signals older than this after a restart are skipped to avoid stale trades.
LIVE_MAX_SIGNAL_AGE_SEC=300

# Sell cooldown between retries for the same call (seconds)
LIVE_SELL_COOLDOWN_SEC=15

# =======================
# Jito bundle submission (MEV-resistant fast TX landing ~400ms)
# =======================
USE_JITO=1

# Tip in lamports (1 SOL = 1_000_000_000 lamports).
# 1000000 = 0.001 SOL. Increase to 2000000 if bundles are being dropped.
JITO_TIP_LAMPORTS=1000000

# How long to wait for Jito bundle confirmation before falling back to Jupiter (seconds)
LIVE_JITO_CONFIRM_SEC=3.0

# =======================
# Strategy key used by live workers to match StrategyResult records
# =======================
# Must match the key computed from DISPLAY_TP_PCT/DISPLAY_SL_PCT:
#   format: tp{int(TP_PCT)}_sl{int(SL_PCT)}
# Example: DISPLAY_TP_PCT=35, DISPLAY_SL_PCT=20 → LIVE_STRATEGY_KEY=tp35_sl20
LIVE_STRATEGY_KEY=tp35_sl20
