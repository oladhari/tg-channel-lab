# =======================
# App
# =======================
APP_ENV=prod
APP_NAME=tg-channel-lab

# =======================
# Database
# =======================
POSTGRES_DB=tg_lab
POSTGRES_USER=tg_lab
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://tg_lab:change_me@db:5432/tg_lab

# =======================
# Telegram (Telethon)
# =======================
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=tg_lab_session

# =======================
# Price recording
# =======================
SCAN_DELAY_SEC=6
RECORDING_WINDOW_MIN=25

# If entry price can't be fetched -> mark seen and skip
ENTRY_PRICE_TIMEOUT_SEC=10

# =======================
# Simulation (for now)
# =======================
SIM_TP_PCT=35
SIM_SL_PCT=20

# =======================
# GMGN (optional later)
# =======================
GMGN_TARGET=
GMGN_SELL_PERCENT=100%
GMGN_COOLDOWN_SEC=45
